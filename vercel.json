{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "^/software-development(?:/.*)?$", "dest": "/index.html" },
    { "src": "^/contact(?:/.*)?$", "dest": "/index.html" },
    { "src": "^/analyticsautomation(?:/.*)?$", "dest": "/index.html" },
    { "src": "^/digitalmarketing(?:/.*)?$", "dest": "/index.html" },
    { "src": "^/uiuxdesign(?:/.*)?$", "dest": "/index.html" },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
